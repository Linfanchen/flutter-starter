import '{{material_import}}';

import 'package:flutter_test/flutter_test.dart';
import 'package:{{project_name}}/app/template_home.dart';
import 'package:starter_storage/starter_storage.dart';

void main() {
  testWidgets('A product can be added, reviewed and ordered', (tester) async {
    await tester.pumpWidget(
      MaterialApp(home: TemplateHome(storage: MemoryStringStore())),
    );
    await tester.pumpAndSettle();
    await tester.tap(find.text('Canvas tote'));
    await tester.pumpAndSettle();
    expect(
      find.text('A reusable everyday bag with a wide shoulder strap.'),
      findsOneWidget,
    );
    await tester.tap(find.text('Add to cart'));
    await tester.tap(find.text('Add to cart'));
    await tester.pageBack();
    await tester.pumpAndSettle();
    await tester.tap(find.text('Cart (2)'));
    await tester.pumpAndSettle();
    expect(find.text('Quantity: 2'), findsOneWidget);
    expect(find.text(r'$36.00'), findsOneWidget);

    final removeProduct = find.byTooltip('Remove one Canvas tote');
    await tester.tap(removeProduct);
    await tester.pump();
    expect(find.text(r'$18.00'), findsOneWidget);
    await tester.tap(find.text('Review order'));
    await tester.pumpAndSettle();
    await tester.pageBack();
    await tester.pumpAndSettle();
    expect(find.text('Quantity: 1'), findsOneWidget);

    await tester.tap(find.text('Review order'));
    await tester.pumpAndSettle();
    await tester.tap(find.text('Place demo order'));
    await tester.pumpAndSettle();
    expect(find.text('Demo order placed'), findsOneWidget);
    expect(find.text(r'Order total: $18.00'), findsOneWidget);
    await tester.tap(find.text('Back to shop'));
    await tester.pumpAndSettle();
    await tester.tap(find.text('Cart (0)'));
    await tester.pumpAndSettle();
    expect(find.text('Your cart is empty.'), findsOneWidget);
  });

  testWidgets('Cart restores after restart and ignores corrupt data', (
    tester,
  ) async {
    final storage = MemoryStringStore({'shop.cart': '{invalid'});
    final app = MaterialApp(home: TemplateHome(storage: storage));
    await tester.pumpWidget(app);
    await tester.pumpAndSettle();
    expect(find.text('Cart (0)'), findsOneWidget);
    await tester.tap(find.text('Canvas tote'));
    await tester.pumpAndSettle();
    await tester.tap(find.text('Add to cart'));
    await tester.pumpAndSettle();

    await tester.pumpWidget(const SizedBox.shrink());
    await tester.pumpWidget(app);
    await tester.pumpAndSettle();
    await tester.tap(find.text('Cart (1)'));
    await tester.pumpAndSettle();
    expect(find.text('Quantity: 1'), findsOneWidget);
    expect(find.text(r'$18.00'), findsOneWidget);
  });
}
