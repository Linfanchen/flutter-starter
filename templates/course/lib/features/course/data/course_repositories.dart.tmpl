/// Validates the API response before it reaches the course pages.
final class RemoteCourseRepository implements CourseRepository {
  const RemoteCourseRepository(this._fetch);

  /// Creates the production repository with the shared JSON client.
  ///
  /// Keeping the endpoint here prevents application assembly from knowing the
  /// transport path while the function constructor remains available for
  /// deterministic tests.
  RemoteCourseRepository.fromClient(ApiClient client)
    : this(() => client.get('courses'));

  final Future<Object?> Function() _fetch;

  @override
  Future<List<Course>> listCourses() async {
    return CourseMapper.listFromJson(await _fetch());
  }
}
