/// A text lesson with a stable ID used to track completion.
final class Lesson {
  const Lesson({required this.id, required this.title, required this.body});

  final String id;
  final String title;
  final String body;
}

/// A course and its lessons in teaching order.
final class Course {
  const Course({
    required this.id,
    required this.title,
    required this.description,
    required this.lessons,
  });

  final String id;
  final String title;
  final String description;
  final List<Lesson> lessons;
}

/// Loads the course catalog independently of its source.
abstract interface class CourseRepository {
  Future<List<Course>> listCourses();
}
