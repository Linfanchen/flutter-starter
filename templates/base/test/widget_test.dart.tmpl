import 'package:flutter_test/flutter_test.dart';
import 'package:{{project_name}}/app/starter_app.dart';

void main() {
  testWidgets('Base template opens its home screen', (tester) async {
    await tester.pumpWidget(const StarterApp());
    expect(find.text('Home'), findsOneWidget);
  });

  testWidgets('Demo restores while the app is open and signs out', (
    tester,
  ) async {
    await tester.pumpWidget(const StarterApp());
    await tester.tap(find.text('Open session demo'));
    await tester.pumpAndSettle();
    await tester.tap(find.text('Sign in as demo'));
    await tester.pumpAndSettle();
    expect(find.text('Signed in as demo'), findsOneWidget);
    await tester.pageBack();
    await tester.pumpAndSettle();
    await tester.tap(find.text('Open session demo'));
    await tester.pumpAndSettle();
    expect(find.text('Signed in as demo'), findsOneWidget);
    await tester.tap(find.text('Sign out'));
    await tester.pumpAndSettle();
    expect(find.text('Signed out'), findsOneWidget);
  });
}
